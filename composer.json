{
  "name": "neos/contentgraph-doctrinedbaladapter-forward-compatibility",
  "type": "neos-package",
  "description": "Forward compatibility layer to allow smooth upgrades to Neos version which provide a new content graph implementation.",
  "support": {
    "source": "https://github.com/neos/contentgraph-doctrinedbaladapter-forward-compatibility",
    "forum": "https://discuss.neos.io/",
    "docs": "https://docs.neos.io/"
  },
  "license": "GPL-3.0+",
  "scripts": {
    "build-generated": [
      "rm -rf src/Generated",
      "@php ./scripts/build-generated 9.2"
    ],
    "lint:phpstan": "../../../bin/phpstan analyse src --level 8"
  },
  "require": {
    "php": ">= 8.2",
    "neos/contentrepository-core": "~9.0.0 || ~9.1.0",
    "neos/contentrepositoryregistry": "~9.0.0 || ~9.1.0",
    "doctrine/dbal": "^3.1.4",
    "doctrine/migrations": "*"
  },
  "autoload": {
    "psr-4": {
      "Neos\\ContentGraph\\DoctrineDbalAdapterForwardCompatibility\\": "src"
    }
  }
}
