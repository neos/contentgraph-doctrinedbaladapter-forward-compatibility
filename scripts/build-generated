#!/usr/bin/env php
<?php

$packageRoot = __DIR__ . '/..';

$version = $argv[1] ?? null;
is_numeric($version) ?: throw new \RuntimeException('Version must be defined as first argument', 1782626938);

if (file_exists($packageRoot . '/original')) {
    echo sprintf('Warning not version %s cloning into "original" because clone exist. Remove beforehand.', $version);
    echo PHP_EOL;
} else {
    exec(sprintf('git -C %s clone git@github.com:neos/neos-development-collection.git --depth 1 --branch %s original', escapeshellarg($packageRoot), escapeshellarg($version)));
}

if (file_exists($packageRoot . '/src/Generated')) {
    echo 'Error "src/Generated" is not empty. Remove beforehand.';
    echo PHP_EOL;
    exit(1);
}
mkdir($packageRoot . '/src/Generated', recursive: true);

$originalSources = new \RecursiveIteratorIterator(
    new \RecursiveDirectoryIterator($packageRoot . '/original/Neos.ContentGraph.DoctrineDbalAdapter/src')
);

$markGenerated = fn (string $contents) => str_replace('<?php', '<?php' . PHP_EOL . '// Code generated by "composer run build-generated"; DO NOT EDIT.', $contents);

/** @var \SplFileInfo $originalSourceFile */
foreach ($originalSources as $originalSourceFile) {
    $relativePathName = str_replace($packageRoot . '/original/Neos.ContentGraph.DoctrineDbalAdapter/src/', '', $originalSourceFile->getPathname());
    $newAbsolutePathName = $packageRoot . '/src/Generated/ContentGraph/' . $relativePathName;

    if ($originalSourceFile->isDir() && !file_exists($newAbsolutePathName)) {
        mkdir($newAbsolutePathName, recursive: true);
    }
    if ($originalSourceFile->isFile()) {
        $newContents = file_get_contents($originalSourceFile->getPathname());
        $newContents = str_replace(
            [
                <<<PHP
                Neos\ContentGraph\DoctrineDbalAdapter
                PHP,
                <<<PHP
                Neos\ContentRepository\Dbal
                PHP
            ],
            [
                <<<PHP
                Neos\ContentGraph\DoctrineDbalAdapterForwardCompatibility\Generated\ContentGraph
                PHP,
                <<<PHP
                Neos\ContentGraph\DoctrineDbalAdapterForwardCompatibility\Generated\Dbal
                PHP
            ],
            $newContents
        );

        if ($originalSourceFile->getFilename() === 'DoctrineDbalContentGraphProjection.php') {
            $newContents = str_replace(
                    [
                        <<<'PHP'
                        final class DoctrineDbalContentGraphProjection implements ContentGraphProjectionInterface
                        {
                        PHP,
                        <<<'PHP'
                        private readonly ContentGraphReadModelInterface $contentGraphReadModel
                        PHP,
                        <<<'PHP'
                            public function getState(): ContentGraphReadModelInterface
                            {
                                return $this->contentGraphReadModel;
                            }
                        
                        
                        PHP,
                    ],
                    [
                        <<<'PHP'
                        abstract class DoctrineDbalContentGraphProjection
                        {
                        PHP,
                        <<<'PHP'
                        protected readonly ContentGraphReadModelInterface $contentGraphReadModel
                        PHP,
                        '',
                    ],
                    $newContents
            );
        }

        if ($originalSourceFile->getFilename() === 'DoctrineDbalContentGraphProjectionFactory.php') {
            continue;
        }

        if ($originalSourceFile->getFilename() === 'ContentGraphTableNames.php') {
            $newContents = str_replace(
                    [
                        <<<'PHP'
                            public static function create(ContentRepositoryId $contentRepositoryId): self
                            {
                                return new self(sprintf('cr_%s_p_graph', $contentRepositoryId->value));
                            }
                        PHP
                    ],
                    [
                        <<<'PHP'
                            public static function create(ContentRepositoryId $contentRepositoryId): self
                            {
                                return new self(sprintf('cr_%s_p_graph', $contentRepositoryId->value));
                            }

                            public static function createNextPrefixed(ContentRepositoryId $contentRepositoryId): self
                            {
                                return new self(sprintf('cr_%s_p_92_graph', $contentRepositoryId->value));
                            }
                        PHP
                    ],
                    $newContents
            );
        }

        if ($originalSourceFile->getFilename() === 'ContentGraphReadModelAdapter.php') {
            $newContents = str_replace(
                    [
                        <<<'PHP'
                                return Workspace::create(
                                    WorkspaceName::fromString($row['name']),
                                    $baseWorkspaceName,
                                    ContentStreamId::fromString($row['currentContentStreamId']),
                                    $status,
                                    $baseWorkspaceName === null
                                        ? false
                                        : (bool)$row['hasChanges'],
                                    Version::fromInteger((int)$row['version']),
                                );
                        PHP,
                        <<<'PHP'
                                return ContentStream::create(
                                    ContentStreamId::fromString($row['id']),
                                    isset($row['sourceContentStreamId']) ? ContentStreamId::fromString($row['sourceContentStreamId']) : null,
                                    Version::fromInteger((int)$row['version']),
                                );
                        PHP
                    ],
                    [
                            <<<'PHP'
                                return Workspace::create(
                                    WorkspaceName::fromString($row['name']),
                                    $baseWorkspaceName,
                                    ContentStreamId::fromString($row['currentContentStreamId']),
                                    $status,
                                    $baseWorkspaceName === null
                                        ? false
                                        : (bool)$row['hasChanges'],
                                );
                        PHP,
                        <<<'PHP'
                                return ContentStream::create(
                                    ContentStreamId::fromString($row['id']),
                                    isset($row['sourceContentStreamId']) ? ContentStreamId::fromString($row['sourceContentStreamId']) : null,
                                    Version::fromInteger((int)$row['version']),
                                    isClosed: false
                                );
                        PHP
                    ],
                    $newContents
            );
        }

        file_put_contents($newAbsolutePathName, $markGenerated($newContents));
    }
}

$originalSources = new \RecursiveIteratorIterator(
    new \RecursiveDirectoryIterator($packageRoot . '/original/Neos.ContentRepository.Dbal/Classes')
);

/** @var \SplFileInfo $originalSourceFile */
foreach ($originalSources as $originalSourceFile) {
    $relativePathName = str_replace($packageRoot . '/original/Neos.ContentRepository.Dbal/Classes/', '', $originalSourceFile->getPathname());
    $newAbsolutePathName = $packageRoot . '/src/Generated/Dbal/' . $relativePathName;

    if ($originalSourceFile->isDir() && !file_exists($newAbsolutePathName)) {
        mkdir($newAbsolutePathName, recursive: true);
    }
    if ($originalSourceFile->isFile()) {
        $newContents = file_get_contents($originalSourceFile->getPathname());
        $newContents = str_replace(
                [
                    <<<PHP
                    Neos\ContentRepository\Dbal
                    PHP
                ],
                [
                    <<<PHP
                    Neos\ContentGraph\DoctrineDbalAdapterForwardCompatibility\Generated\Dbal
                    PHP
                ],
                $newContents
        );

        if ($originalSourceFile->getFilename() === 'DoctrineSubscriptionStore.php') {
            continue;
        }

        file_put_contents($newAbsolutePathName, $markGenerated($newContents));
    }
}


$originalSources = new \RecursiveIteratorIterator(
    new \RecursiveDirectoryIterator($packageRoot . '/original/Neos.ContentRepositoryRegistry/Classes/Upgrade')
);

/** @var \SplFileInfo $originalSourceFile */
foreach ($originalSources as $originalSourceFile) {
    $relativePathName = str_replace($packageRoot . '/original/Neos.ContentRepositoryRegistry/Classes/Upgrade/', '', $originalSourceFile->getPathname());
    $newAbsolutePathName = $packageRoot . '/src/Generated/Upgrade/' . $relativePathName;

    if ($originalSourceFile->isDir() && !file_exists($newAbsolutePathName)) {
        mkdir($newAbsolutePathName, recursive: true);
    }
    if ($originalSourceFile->isFile()) {
        $newContents = file_get_contents($originalSourceFile->getPathname());
        $newContents = str_replace(
                [
                    <<<PHP
                    Neos\ContentRepositoryRegistry\Upgrade
                    PHP
                ],
                [
                    <<<PHP
                    Neos\ContentGraph\DoctrineDbalAdapterForwardCompatibility\Generated\Upgrade
                    PHP
                ],
                $newContents
        );

        if ($originalSourceFile->getFilename() === 'ResetupAndReplayContentGraphUpgrade.php') {
            continue;
        }

        if ($originalSourceFile->getFilename() === 'CRUpgradeCommandController.php') {
            continue;
        }

        file_put_contents($newAbsolutePathName, $markGenerated($newContents));
    }
}

